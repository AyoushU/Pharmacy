@using MedicalShop.Application.DTOs.Inventory
@model List<InventoryDto>
@using MedicalShop.Domain.Entities
@{
    ViewData["Title"] = "Inventory";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Inventory Management</h2>
            <p class="text-muted mb-0">View and manage available stock.</p>
        </div>

        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addStockModal">
            + Add Stock
        </button>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product Code</th>
                            <th>Product Name</th>
                            <th>Batch Number</th>
                            <th>Expiry Date</th>
                            <th>Quantity</th>
                            <th>Purchase Price</th>
                            <th>Selling Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductCode</td>
                                    <td>@item.ProductName</td>
                                    <td>@(item.BatchNumber ?? "-")</td>
                                    <td>
                                        @(item.ExpiryDate.HasValue
                                            ? item.ExpiryDate.Value.ToString("dd-MMM-yyyy")
                                            : "-")
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@item.PurchasePrice.ToString("N2")</td>
                                    <td>@item.SellingPrice.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No stock available. Create a purchase or add stock.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Stock Modal - Form will be added in the next step -->
@{
    var products = ViewBag.Products as IEnumerable<Product>
        ?? Enumerable.Empty<Product>();
}

<div class="modal fade" id="addStockModal" tabindex="-1"
     aria-labelledby="addStockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Inventory"
                  asp-action="AddStock"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="addStockModalLabel">
                        Add Stock
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Product</label>
                        <select name="ProductId" class="form-select" required>
                            <option value="">Select Product</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.ProductId">
                                    @product.ProductCode - @product.ProductName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Batch Number</label>
                        <input type="text" name="BatchNumber"
                               class="form-control" maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Expiry Date</label>
                        <input type="date" name="ExpiryDate"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Quantity"
                               class="form-control" min="1" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Purchase Price</label>
                        <input type="number" name="PurchasePrice"
                               class="form-control" min="0.01"
                               step="0.01" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Selling Price</label>
                        <input type="number" name="SellingPrice"
                               class="form-control" min="0.01"
                               step="0.01" required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Save Stock
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

