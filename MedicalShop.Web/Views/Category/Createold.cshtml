@model MedicalShop.Application.DTOs.Categories.CreateCategoryDto

@{
    ViewData["Title"] = "Create Category";
}

<h2>Create Category</h2>

<hr />

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="CategoryName"
               class="form-label">
        </label>

        <input asp-for="CategoryName"
               class="form-control" />

        <span asp-validation-for="CategoryName"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="3">
        </textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Category
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}