@model MedicalShop.Application.DTOs.PurchaseReturn.PurchaseReturnDto

@{
    ViewData["Title"] = "Create Purchase Return";
}

<h2 class="mb-3">Create Purchase Return</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="PurchaseId" value="@Model.PurchaseId" />

    <div class="card mb-3">
        <div class="card-body">
            <h5>Purchase Information</h5>

            <div class="row">
                <div class="col-md-4">
                    <strong>Purchase No:</strong> @Model.PurchaseNumber
                </div>
                <div class="col-md-4">
                    <strong>Supplier:</strong> @Model.SupplierName
                </div>
                <div class="col-md-4">
                    <strong>Purchase Date:</strong>
                    @Model.PurchaseDate.ToString("dd-MM-yyyy")
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Return Information</h5>

            <div class="mb-3">
                <label class="form-label">Return Date</label>
                <input type="date"
                       name="ReturnDate"
                       class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Reason</label>
                <textarea name="Reason"
                          class="form-control"
                          rows="2"
                          maxlength="500"
                          required></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Products to Return</h5>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Batch</th>
                            <th>Expiry</th>
                            <th>Purchased Qty</th>
                            <th>Previously Returned</th>
                            <th>Available Return Qty</th>
                            <th>Purchase Price</th>
                            <th>Return Qty</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];

                            <tr>
                                <td>
                                    @item.ProductName

                                    <input type="hidden"
                                           name="Items[@i].PurchaseDetailId"
                                           value="@item.PurchaseDetailId" />

                                    <input type="hidden"
                                           name="Items[@i].StockId"
                                           value="@item.StockId" />
                                </td>

                                <td>@item.BatchNumber</td>

                                <td>
                                    @(item.ExpiryDate?.ToString("dd-MM-yyyy") ?? "-")
                                </td>

                                <td>@item.PurchasedQuantity</td>

                                <td>@item.PreviouslyReturnedQuantity</td>

                                <td>@item.AvailableReturnQuantity</td>

                                <td>@item.PurchasePrice.ToString("N2")</td>

                                <td>
                                    <input type="number"
                                           name="Items[@i].Quantity"
                                           class="form-control"
                                           min="0"
                                           max="@item.AvailableReturnQuantity"
                                           value="0"
                                           disabled="@(item.AvailableReturnQuantity <= 0)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Purchase Return
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
