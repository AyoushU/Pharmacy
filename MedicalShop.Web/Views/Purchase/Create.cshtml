@model MedicalShop.Web.ViewModels.Purchases.PurchaseCreateViewModel

@{
    ViewData["Title"] = "Create Purchase";
}

<h2>Create Purchase</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="row mb-3">

        <div class="col-md-4">
            <label asp-for="SupplierId" class="form-label"></label>

            <select asp-for="SupplierId"
                    asp-items="Model.Suppliers"
                    class="form-select">
                <option value="">-- Select Supplier --</option>
            </select>

            <span asp-validation-for="SupplierId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PurchaseDate" class="form-label"></label>

            <input asp-for="PurchaseDate"
                   class="form-control" />

            <span asp-validation-for="PurchaseDate"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="InvoiceNumber" class="form-label"></label>

            <input asp-for="InvoiceNumber"
                   class="form-control" />

            <span asp-validation-for="InvoiceNumber"
                  class="text-danger"></span>
        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">
            <label asp-for="InvoiceDate" class="form-label"></label>

            <input asp-for="InvoiceDate"
                   class="form-control" />

            <span asp-validation-for="InvoiceDate"
                  class="text-danger"></span>
        </div>

    </div>

    <hr />

    <h4>Purchase Items</h4>

    <div class="table-responsive">

        <table class="table table-bordered"
               id="purchaseItemsTable">

            <thead>
                <tr>
                    <th>Product</th>
                    <th>Batch</th>
                    <th>Expiry</th>
                    <th>Quantity</th>
                    <th>Purchase Price</th>
                    <th>GST %</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="purchaseItemsBody">

                <tr>
                    <td>
                        <select name="Details[0].ProductId"
                                class="form-select">

                            <option value="">
                                -- Select Product --
                            </option>

                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Value">
                                    @product.Text
                                </option>
                            }

                        </select>
                    </td>

                    <td>
                        <input name="Details[0].BatchNumber"
                               class="form-control" />
                    </td>

                    <td>
                        <input name="Details[0].ExpiryDate"
                               type="date"
                               class="form-control" />
                    </td>

                    <td>
                        <input name="Details[0].Quantity"
                               type="number"
                               min="1"
                               class="form-control quantity" />
                    </td>

                    <td>
                        <input name="Details[0].PurchasePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control purchase-price" />
                    </td>

                    <td>
                        <input name="Details[0].GSTPercentage"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100"
                               class="form-control gst-percentage" />
                    </td>

                    <td>
                        <input name="Details[0].TotalAmount"
                               type="number"
                               step="0.01"
                               class="form-control line-total"
                               readonly />
                    </td>
                </tr>

            </tbody>

        </table>
        <button type="button"
                id="addProductBtn"
                class="btn btn-success mb-3">
            + Add Product
        </button>
    </div>

    <div class="row mt-3">

        <div class="col-md-4 offset-md-8">

            <div class="mb-2">
                <label asp-for="TotalAmount"
                       class="form-label"></label>

                <input asp-for="TotalAmount"
                       class="form-control"
                       readonly />
            </div>

            <div class="mb-2">
                <label asp-for="GSTAmount"
                       class="form-label"></label>

                <input asp-for="GSTAmount"
                       class="form-control"
                       readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NetAmount"
                       class="form-label"></label>

                <input asp-for="NetAmount"
                       class="form-control"
                       readonly />
            </div>

        </div>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Purchase
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let rowIndex = 1;

        document.getElementById("addProductBtn")
            .addEventListener("click", function() {

                const tbody =
                    document.getElementById("purchaseItemsBody");

                const row = document.createElement("tr");

                row.innerHTML = `
                        <td>
                            <select name="Details[${rowIndex}].ProductId"
                                    class="form-select">
                                <option value="">
                                    -- Select Product --
                                </option>

                                @foreach (var product in Model.Products)
                                {
                                        <option value="@product.Value">
                                                @product.Text
                                        </option>
                                }
                            </select>
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].BatchNumber"
                                   class="form-control" />
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].ExpiryDate"
                                   type="date"
                                   class="form-control" />
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control quantity" />
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].PurchasePrice"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control purchase-price" />
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].GSTPercentage"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   class="form-control gst-percentage" />
                        </td>

                        <td>
                            <input name="Details[${rowIndex}].TotalAmount"
                                   type="number"
                                   step="0.01"
                                   class="form-control line-total"
                                   readonly />
                        </td>

                        <td>
                            <button type="button"
                                    class="btn btn-danger remove-row">
                                Remove
                            </button>
                        </td>
                    `;

                tbody.appendChild(row);

                rowIndex++;
            });


        // Remove row
        document.addEventListener("click", function(event) {

            if (event.target.classList.contains("remove-row")) {

                event.target.closest("tr").remove();

                calculateTotals();
            }
        });


        // Calculate when quantity / price / GST changes
        document.addEventListener("input", function(event) {

            if (event.target.classList.contains("quantity") ||
                event.target.classList.contains("purchase-price") ||
                event.target.classList.contains("gst-percentage")) {

                calculateTotals();
            }
        });


        function calculateTotals() {

            let totalAmount = 0;
            let gstAmount = 0;

            const rows =
                document.querySelectorAll("#purchaseItemsBody tr");

            rows.forEach(function(row) {

                const quantity =
                    parseFloat(
                        row.querySelector(".quantity")?.value
                    ) || 0;

                const purchasePrice =
                    parseFloat(
                        row.querySelector(".purchase-price")?.value
                    ) || 0;

                const gstPercentage =
                    parseFloat(
                        row.querySelector(".gst-percentage")?.value
                    ) || 0;


                // Quantity × Purchase Price
                const baseAmount =
                    quantity * purchasePrice;


                // GST
                const rowGST =
                    baseAmount * gstPercentage / 100;


                // Total including GST
                const rowTotal =
                    baseAmount + rowGST;


                const lineTotalInput =
                    row.querySelector(".line-total");

                if (lineTotalInput) {
                    lineTotalInput.value =
                        rowTotal.toFixed(2);
                }


                totalAmount += baseAmount;

                gstAmount += rowGST;
            });


            const netAmount =
                totalAmount + gstAmount;


            document.getElementById("TotalAmount").value =
                totalAmount.toFixed(2);

            document.getElementById("GSTAmount").value =
                gstAmount.toFixed(2);

            document.getElementById("NetAmount").value =
                netAmount.toFixed(2);
        }
        calculateTotals();
    </script>

}
