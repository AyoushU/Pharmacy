@using MedicalShop.Domain.Entities
@model Sale

@{
    ViewData["Title"] = "Sales Invoice";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Sales Invoice</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to Sales
            </a>
            <button type="button" class="btn btn-primary"
                    onclick="window.print()">
                Print Invoice
            </button>
        </div>
    </div>

    <div class="card shadow-sm" id="invoice">
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-sm-7">
                    <h3>Medical Shop</h3>
                    <p class="text-muted mb-0">Sales Invoice</p>
                </div>
                <div class="col-sm-5 text-sm-end">
                    <strong>Invoice:</strong> @Model.InvoiceNumber<br />
                    <strong>Date:</strong> @Model.SaleDate.ToString("dd-MMM-yyyy HH:mm")<br />
                    <strong>Customer:</strong>
                    @(Model.Customer?.CustomerName ?? "Walk-in Customer")
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Medicine</th>
                            <th>Batch</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>GST %</th>
                            <th>GST Amount</th>
                            <th>Discount</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SaleDetails)
                        {
                            <tr>
                                <td>@item.Product.ProductName</td>
                                <td>@(item.Stock.BatchNumber ?? "-")</td>
                                <td>@item.Quantity</td>
                                <td>₹@item.UnitPrice.ToString("N2")</td>
                                <td>@item.GSTPercentage.ToString("N2")%</td>
                                <td>₹@item.GSTAmount.ToString("N2")</td>
                                <td>₹@item.DiscountAmount.ToString("N2")</td>
                                <td>₹@item.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5">
                    <table class="table table-sm">
                       @*  <tr>
                            <th>Subtotals</th>
                            <td class="text-end">₹@Model.SubTotal.ToString("N2")</td>
                        </tr> *@
                       @*  <tr>
                            <th>GST</th>
                            <td class="text-end">₹@Model.GSTAmount.ToString("N2")</td>
                        </tr> *@
                        @* <tr>
                            <th>Total Discount</th>
                            <td class="text-end">₹@Model.DiscountAmount.ToString("N2")</td>
                        </tr> *@
                        @* <tr>
                            <th>Net Amount</th>
                            <th class="text-end">₹@Model.NetAmount.ToString("N2")</th>
                        </tr> *@
                        <tr>
                            <th>Payment Method</th>
                            <td class="text-end">@Model.PaymentMethod</td>
                        </tr>
                        <div class="card shadow-sm mt-4">
                            <div class="card-body">
                                <h5 class="fw-bold mb-3">Payment Summary</h5>

                                <div class="row mb-2">
                                    <div class="col-6 text-muted">Subtotal</div>
                                    <div class="col-6 text-end">
                                        ₹@Model.SubTotal.ToString("N2")
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-6 text-muted">GST Amount</div>
                                    <div class="col-6 text-end">
                                        ₹@Model.GSTAmount.ToString("N2")
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-6 text-muted">Discount</div>
                                    <div class="col-6 text-end">
                                        ₹@Model.DiscountAmount.ToString("N2")
                                    </div>
                                </div>

                                <hr />

                                <div class="row mb-2">
                                    <div class="col-6 fw-bold">Net Amount</div>
                                    <div class="col-6 text-end fw-bold">
                                        ₹@Model.NetAmount.ToString("N2")
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-6 text-success">Amount Received</div>
                                    <div class="col-6 text-end text-success fw-bold">
                                        ₹@Model.AmountPaid.ToString("N2")
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-6 text-danger">Balance Due</div>
                                    <div class="col-6 text-end text-danger fw-bold">
                                        ₹@Model.BalanceDue.ToString("N2")
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-6 fw-bold">Payment Status</div>
                                    <div class="col-6 text-end">
                                        @if (Model.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (Model.PaymentStatus == "PartiallyPaid")
                                        {
                                            <span class="badge bg-warning text-dark">Partially Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        #invoice, #invoice * {
            visibility: visible;
        }

        #invoice {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
        }

        .btn, a {
            display: none !important;
        }
    }
</style>
