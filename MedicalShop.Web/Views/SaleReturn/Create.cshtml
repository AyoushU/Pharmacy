@model MedicalShop.Application.DTOs.SaleReturn.SaleReturnDto

@{
    ViewData["Title"] = "Create Sale Return";
}
<h2 class="mb-3">Create Sale Return</h2>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" name="SaleId" value="@Model.SaleId" />

    <div class="card mb-3">
        <div class="card-body">
            <h5>Sale Information</h5>

            <div class="row">
                <div class="col-md-4">
                    <strong>Sale No:</strong> @Model.InvoiceNumber
                </div>
                <div class="col-md-4">
                    <strong>Sale Date:</strong>
                    @Model.SaleDate.ToString("dd-MM-yyyy")
                </div>
            </div>
        </div>
    </div>



</form>