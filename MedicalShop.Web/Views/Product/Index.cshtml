@model List<MedicalShop.Application.DTOs.Products.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Products</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Product
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Code</th>
            <th>Product</th>
            <th>Category</th>
            <th>Purchase Price</th>
            <th>Selling Price</th>
            <th>GST %</th>
            <th>Quantity</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var product in Model)
        {
            <tr>

                <td>
                    @product.ProductCode
                </td>

                <td>
                    @product.ProductName
                </td>

                <td>
                    @product.CategoryName
                </td>

                <td>
                    ₹ @product.PurchasePrice.ToString("N2")
                </td>

                <td>
                    ₹ @product.SellingPrice.ToString("N2")
                </td>

                <td>
                    @product.GSTPercentage %
                </td>

                <td>
                    @product.Quantity
                </td>

                <td>
                    @if (product.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactive
                        </span>
                    }
                </td>

            </tr>
        }

    </tbody>

</table>