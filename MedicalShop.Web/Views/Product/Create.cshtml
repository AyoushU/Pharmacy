@model MedicalShop.Web.ViewModels.Products.ProductCreateViewModel

@{
    ViewData["Title"] = "Create Product";
}

<h2>Create Product</h2>

<hr />

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">

            <label asp-for="ProductCode"
                   class="form-label">
            </label>

            <input asp-for="ProductCode"
                   class="form-control" />

            <span asp-validation-for="ProductCode"
                  class="text-danger">
            </span>

        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="ProductName"
                   class="form-label">
            </label>

            <input asp-for="ProductName"
                   class="form-control" />

            <span asp-validation-for="ProductName"
                  class="text-danger">
            </span>
            
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">
                <option value="">-- Select Category --</option>
            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="Manufacturer"
                   class="form-label">
            </label>

            <input asp-for="Manufacturer"
                   class="form-control" />

        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="BatchNumber"
                   class="form-label">
            </label>

            <input asp-for="BatchNumber"
                   class="form-control" />

        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="ExpiryDate"
                   class="form-label">
            </label>

            <input asp-for="ExpiryDate"
                   type="date"
                   class="form-control" />

        </div>

        <div class="col-md-4 mb-3">

            <label asp-for="PurchasePrice"
                   class="form-label">
            </label>

            <input asp-for="PurchasePrice"
                   type="number"
                   step="0.01"
                   class="form-control" />

        </div>

        <div class="col-md-4 mb-3">

            <label asp-for="SellingPrice"
                   class="form-label">
            </label>
            <span asp-validation-for="SellingPrice"
                  class="text-danger"></span>
            <input asp-for="SellingPrice"
                   type="number"
                   step="0.01"
                   class="form-control" />

        </div>

        <div class="col-md-4 mb-3">

            <label asp-for="GSTPercentage"
                   class="form-label">
            </label>

            <input asp-for="GSTPercentage"
                   type="number"
                   step="0.01"
                   class="form-control" />

        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="Quantity"
                   class="form-label">
            </label>

            <input asp-for="Quantity"
                   type="number"
                   class="form-control" />

        </div>

        <div class="col-md-6 mb-3">

            <label asp-for="ReorderLevel"
                   class="form-label">
            </label>

            <input asp-for="ReorderLevel"
                   type="number"
                   class="form-control" />

        </div>

        <div class="col-md-12 mb-3">

            <label asp-for="Description"
                   class="form-label">
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="3">
            </textarea>

        </div>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Product
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}