              "lit": "$source = Join-Path $env:RUNNER_TEMP \"MedicalShop-Build\"\n$destination = \"C:\\inetpub\\MedicalShop\"\n$offline = Join-Path $destination \"app_offline.htm\"\n\nNew-Item -ItemType File -Path $offline -Force | Out-Null\n\ntry {\n    robocopy $source $destination /E /R:3 /W:5 /XF appsettings.json appsettings.*.json\n\n    if ($LASTEXITCODE -ge 8) {\n        throw \"Deployment file copy failed. Robocopy exit code: $LASTEXITCODE\"\n    }\n}\nfinally {\n    Remove-Item $offline -Force -ErrorAction SilentlyContinue\n}\n\nWrite-Host \"MedicalShop deployment completed.\"\n"
